:{$PORT}

# Browser requests should stay relative, e.g. /api/chat
# On Railway, set BACKEND_URL to the full backend URL, including http(s).
# Example: BACKEND_URL=https://your-backend.up.railway.app
handle /api/* {
    reverse_proxy {$BACKEND_URL:http://localhost:5000} {
        header_up Host {upstream_hostport}
        header_up X-Forwarded-Proto {scheme}
    }
}

handle {
    root * dist
    file_server
    try_files {path} /index.html
    encode gzip
}